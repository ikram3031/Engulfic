# ============================================================
#  ENGULFIC — .env.example
#  Copy this to .env on VPS and fill in the values:
#  cp .env.example .env && nano .env
# ============================================================

# ── Container Names ──────────────────────────────────────────
MONGODB_CONTAINER_NAME=engulfic-mongodb
BACKEND_CONTAINER_NAME=engulfic-backend
FRONTEND_CONTAINER_NAME=engulfic-frontend
DASHBOARD_CONTAINER_NAME=engulfic-dashboard

# ── Ports ────────────────────────────────────────────────────
BACKEND_PORT=5092
FRONTEND_PORT=8001
DASHBOARD_PORT=8005
MONGODB_PORT=27017

# ── MongoDB ──────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_THIS_PASSWORD
MONGO_INITDB_DATABASE=engulfic-db

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5092
MONGODB_URI=mongodb://admin:CHANGE_THIS_PASSWORD@mongodb:27017/engulfic-db?authSource=admin
MONGODB_DB_NAME=engulfic-db
ACCESS_TOKEN_SECRET=CHANGE_THIS_SECRET_MIN_32_CHARS
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_MS=2592000000
ALLOW_SUPER_ADMIN_CREATION=true

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=https://server.engulfic.com

# ── Dashboard (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=https://server.engulfic.com

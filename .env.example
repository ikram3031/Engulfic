# ============================================================
#  ENGULFIC — .env.example
#  Copy this to .env on VPS and fill in the values:
#  cp .env.example .env && nano .env
# ============================================================

# ── Container Names ──────────────────────────────────────────
MONGODB_CONTAINER_NAME=engulfic-mongodb-dev
BACKEND_CONTAINER_NAME=engulfic-backend-dev
FRONTEND_CONTAINER_NAME=engulfic-frontend-dev
DASHBOARD_CONTAINER_NAME=engulfic-dashboard-dev

# ── Ports ────────────────────────────────────────────────────
BACKEND_PORT=5093
FRONTEND_PORT=8002
DASHBOARD_PORT=8006
MONGODB_PORT=27019

# ── MongoDB ──────────────────────────────────────────────────
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=engulfic_dev_pass_2024
MONGO_INITDB_DATABASE=engulfic-db-dev

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5093
MONGODB_URI=mongodb://admin:engulfic_dev_pass_2024@mongodb:27017/engulfic-db-dev?authSource=admin
MONGODB_DB_NAME=engulfic-db-dev
ACCESS_TOKEN_SECRET=engulfic_access_token_secret_dev_key_xk92ms
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_MS=2592000000
ALLOW_SUPER_ADMIN_CREATION=true
UPLOADS_PATH=/plexivia/engulficDev/uploads

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=http://144.79.218.8:5093

# ── Dashboard (Next.js) ──────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://144.79.218.8:5093
